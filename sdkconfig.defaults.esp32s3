# ESP32-S3 N16R8: 16 MB flash, existing dual-OTA layout, PSRAM disabled pending verification.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb_ota.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=4

# Local HTTPS on port 443 next to HTTP on port 80 (S3 only; C3 stays HTTP-only).
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
# Two HTTP servers (6+2 and 3+2 sockets) plus MQTT/OTA exceed the default of 10
# sockets; accept() then fails with ENFILE and every client sees a reset.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=24
